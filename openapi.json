                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Consumption",
        "tags": [
          "Meters"
        ]
      }
    },
    "/api/v1/network/nodes": {
